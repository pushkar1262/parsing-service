# Copy to .env and fill in. Never commit the real file — .env is gitignored.
#
# Only S3_BUCKET and AWS_REGION are required. Everything else has a default, and the
# defaults are the safe ones: `python -m work.main --check` prints the resolved
# configuration (with credentials masked) and reaches every dependency, so run that first.

# ---- blob storage (required) -------------------------------------------------
S3_BUCKET=
AWS_REGION=
# Prefix raw uploads live under. A job may then carry a bare key
# ("doc-42/spec.pdf") and it resolves to s3://$S3_BUCKET/$S3_PREFIX/doc-42/spec.pdf.
# Leading and trailing slashes are optional.
S3_PREFIX=

# Credentials. Leave both blank in production and use an IAM task/node role instead —
# boto3's credential chain picks it up, and a key that does not exist cannot leak.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only for an S3-compatible endpoint. Leave blank for AWS.
AWS_ENDPOINT_URL=

# Where parsed artifacts go. Defaults to S3_BUCKET with no prefix. Worth separating:
# parsed content is cheap to regenerate and can expire aggressively under a lifecycle
# rule, while a raw upload cannot.
S3_ARTIFACT_BUCKET=
S3_ARTIFACT_PREFIX=

# ---- infrastructure ----------------------------------------------------------
# There is no database. This service keeps no state: a parse produces an object in S3 and
# an event on Kafka, and the document's status, run history and tenancy all live upstream.
#
# Unset means no retries, no dead-letter queue and — more seriously — no outcome events at
# all, so nothing upstream ever learns that a document was parsed. Development only.
KAFKA_BOOTSTRAP_SERVERS=172.16.15.29:9092
KAFKA_GROUP_ID=parsing-service

# The topic the upload backend publishes to. Outcomes always go to
# documents.parse.completed and documents.parse.failed, which are not configurable — a
# consumer cannot subscribe to a topic whose name is a deployment variable.
KAFKA_TOPIC_REQUESTED=documents.parse.requested

# ---- fetch policy ------------------------------------------------------------
MAX_FETCH_BYTES=104857600

# Turn on only behind an S3 VPC endpoint, where the bucket legitimately resolves to a
# private address. Off means a URL resolving to a private or link-local address is
# refused — which is what stops a job reference reaching the instance metadata service
# and returning this worker's own IAM credentials as a "document".
ALLOW_PRIVATE_NETWORKS=false

# Tighter still: restrict HTTP fetches to these host suffixes. Comma-separated.
ALLOWED_HOST_SUFFIXES=

# Permit file:// and bare-path references under these roots. Empty means local
# references are refused outright, which is right for a worker.
LOCAL_ROOTS=

# ---- tenancy -----------------------------------------------------------------
# Nothing to configure. The tenant arrives on the upload event and leaves on the outcome
# event; this service enforces nothing, because it has no store to enforce against.
#
# One consequence worth knowing before exposing the read API: content is addressed by hash,
# so a content_hash is a bearer capability and two tenants who upload the same file share one
# artifact. Keep the API on an internal network with upstream proxying reads.

# ---- parsing -----------------------------------------------------------------
# Part of the idempotency key: bumping it makes a reprocess actually re-parse rather
# than recognise the run as already done.
PARSER_VERSION=1.0

# Ruled-table extraction in PDFs. A second pass over the file and the slow part of
# parsing a large one, but a requirements table read as loose lines is a silent loss.
EXTRACT_TABLES=true

# OCR needs the tesseract binary as well as the Python package. Without it, scanned
# pages are flagged and warned about rather than read.
OCR_ENABLED=true
OCR_DPI=200
OCR_LANGUAGE=eng
